<Application x:Class="VideoQualityAnalyzer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#141922" />
        <SolidColorBrush x:Key="PanelBrush" Color="#202837" />
        <SolidColorBrush x:Key="TextBrush" Color="#F1F5FA" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
    </Application.Resources>
</Application>
