<Window x:Class="VideoQualityAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="動画品質アナライザー"
        Width="1800" Height="860" MinWidth="980" MinHeight="620"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="SidebarColumn" Width="650" MinWidth="300" />
                <ColumnDefinition Name="SidebarSplitterColumn" Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Name="SidebarPanel" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="動画一覧" Style="{StaticResource UiSectionStyle}" Margin="3,2,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Name="AddVideoButton" Content="追加" Click="Add_Click" />
                            <Button Name="SetReferenceButton" Content="元動画に設定" Click="SetReference_Click" MinWidth="100" />
                            <Button Name="RemoveVideoButton" Content="削除" Click="Remove_Click" />
                                                        <Button Content="グループ設定" Click="SetGroup_Click" />
                        </WrapPanel>
                        <TextBlock Text="複数選択できます。ファイルのドラッグ＆ドロップにも対応。" TextWrapping="Wrap" Foreground="{StaticResource UiMutedBrush}" Margin="3,0,3,8" />
                    </StackPanel>
                    <StackPanel Name="EvaluationControls" DockPanel.Dock="Bottom" Margin="3,10,3,0">
                        <TextBlock Text="評価設定" Style="{StaticResource UiSectionStyle}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Name="EvaluationHelpBorder" Loaded="EvaluationHelpBorder_Loaded" Grid.Column="0" BorderBrush="{StaticResource UiMutedBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,12,0">
                                <TextBlock Name="EvaluationHelpText" Text="評価方法にマウスを合わせると解説を表示します。" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Grid.Column="1" Name="EvaluationMetricChecks" Width="150" Orientation="Vertical">
                            <CheckBox Name="VmafCheck" FontSize="{StaticResource UiFontLarge}" FontWeight="SemiBold" Content="VMAF" Margin="0,3,0,3" VerticalAlignment="Center" />
                            <CheckBox Name="SsimCheck" FontSize="{StaticResource UiFontLarge}" FontWeight="SemiBold" Content="SSIM" IsChecked="True" Margin="0,3,0,3" VerticalAlignment="Center" />
                            <CheckBox Name="PsnrCheck" FontSize="{StaticResource UiFontLarge}" FontWeight="SemiBold" Content="PSNR" Margin="0,3,0,3" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Button HorizontalAlignment="Right" Margin="0,8,0,0" Name="EvaluationStartButton" Content="評価を開始" Click="Evaluate_Click" Width="220" />
                        <TextBlock Name="EvaluationStatus" FontSize="{StaticResource UiFontSmall}" Text="" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource UiMutedBrush}" />
                    </StackPanel>
                    <DataGrid Name="VideoList" SelectionMode="Extended" SelectionUnit="FullRow"
                              PreviewMouseLeftButtonDown="VideoList_PreviewMouseLeftButtonDown" SelectionChanged="VideoList_SelectionChanged" Sorting="VideoList_Sorting"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="True" RowHeaderWidth="0"
                              Background="#17202D" Foreground="{StaticResource TextBrush}" RowBackground="#17202D" AlternatingRowBackground="#202837"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="{StaticResource UiOnLightBrush}" />
                                <Setter Property="Padding" Value="5,6" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ファイル名" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="230" />
                            <DataGridTextColumn Header="グループ" Binding="{Binding Group}" SortMemberPath="Group" Width="100" />
                            <DataGridTextColumn Header="コーデック" Binding="{Binding Descriptor.Codec}" SortMemberPath="Codec" Width="SizeToCells" MinWidth="70" MaxWidth="100" />
                            <DataGridTextColumn Header="kbps" Binding="{Binding AverageBitrateKbps, StringFormat=N0}" SortMemberPath="Bitrate" Width="SizeToCells" MinWidth="65" MaxWidth="100" />
                            <DataGridTextColumn Header="VMAF" Binding="{Binding VmafAverage, StringFormat=F4}" SortMemberPath="Vmaf" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn Header="SSIM" Binding="{Binding SsimAverage, StringFormat=F4}" SortMemberPath="Ssim" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn Header="PSNR" Binding="{Binding PsnrAverage, StringFormat=F4}" SortMemberPath="Psnr" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn Header="解像度" Binding="{Binding Resolution}" SortMemberPath="Resolution" Width="SizeToCells" MinWidth="80" MaxWidth="110" />
                            <DataGridTextColumn Binding="{Binding FrameRateText}" SortMemberPath="FrameRate" Width="SizeToCells" MinWidth="65" MaxWidth="115">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="fps" ToolTip="可変表示は、公称fpsと平均fpsの差による推定です。全フレームの時刻による判定ではありません。" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Name="SidebarSplitter" Grid.Column="1" Margin="0,36,0,0" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#405066" />
            <Button Name="SidebarToggleButton" Grid.Column="1" Content="◀" ToolTip="一覧を最小化" AutomationProperties.Name="一覧を最小化"
                    Click="SidebarToggle_Click" Width="28" Height="30" MinWidth="0" Padding="0" Margin="2,0,2,0" VerticalAlignment="Top" />
            <Grid Grid.Column="2" Name="PreviewLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Name="PreviewRow" Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Name="QualityGraphRow" Height="260" MinHeight="200" />
                </Grid.RowDefinitions>
                <TabControl Name="InitialPreviewTabs" Grid.Row="0" SelectedIndex="0" Background="{StaticResource BackgroundBrush}">
                    <TabItem>
                        <TabItem.Header><TextBlock Text="2画面" Foreground="{StaticResource UiOnLightBrush}" /></TabItem.Header>
                <Grid Name="LegacyPreviewGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <MediaElement Name="LeftMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Opacity="0"
                                          ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="LeftMedia_Opened" MediaFailed="LeftMedia_Failed" MediaEnded="Media_Ended" />
                            <Image Name="LeftAv1Image" Stretch="Uniform" Visibility="Collapsed" />
                            <Border VerticalAlignment="Top" Background="#CC17202D" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Name="LeftName" Text="左: 未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Name="LeftDetails" FontSize="{StaticResource UiFontSmall}" Foreground="{StaticResource UiMutedBrush}" />
                                    <TextBlock Name="LeftFrameStatus" Style="{StaticResource UiSmallTextStyle}" />
                                    <TextBlock Name="LeftStatus" Text="待機中" Foreground="{StaticResource UiMutedBrush}" FontSize="{StaticResource UiFontSmall}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <MediaElement Name="RightMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Opacity="0"
                                          ScrubbingEnabled="True" Stretch="Uniform" IsMuted="True"
                                          MediaOpened="RightMedia_Opened" MediaFailed="RightMedia_Failed" MediaEnded="Media_Ended" />
                            <Image Name="RightAv1Image" Stretch="Uniform" Visibility="Collapsed" />
                            <Border VerticalAlignment="Top" Background="#CC17202D" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Name="RightName" Text="右: 未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Name="RightDetails" FontSize="{StaticResource UiFontSmall}" Foreground="{StaticResource UiMutedBrush}" />
                                    <TextBlock Name="RightFrameStatus" Style="{StaticResource UiSmallTextStyle}" />
                                    <TextBlock Name="RightStatus" Text="待機中" Foreground="{StaticResource UiMutedBrush}" FontSize="{StaticResource UiFontSmall}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header><TextBlock Text="ワイプ" Foreground="{StaticResource UiOnLightBrush}" /></TabItem.Header>
                        <TextBlock Text="比較する動画を2本選択してください。" Foreground="{StaticResource TextBrush}" Margin="12" />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header><TextBlock Text="差分ヒートマップ" Foreground="{StaticResource UiOnLightBrush}" /></TabItem.Header>
                        <TextBlock Text="比較する動画を2本選択してください。" Foreground="{StaticResource TextBrush}" Margin="12" />
                    </TabItem>
                </TabControl>
                <ContentControl Grid.Row="0" Name="ComparisonHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <TextBlock Grid.Row="1" Name="MeasurementText" FontSize="{StaticResource UiFontSmall}" Text="再生位置からの換算fps: 左 — / 右 —　｜　実提示fps: 未測定"
                           Foreground="{StaticResource UiWarningBrush}" Margin="4,10,4,4" TextWrapping="Wrap" />
        <Border Name="PlaybackControls" Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Name="TimeText" DockPanel.Dock="Left" Text="00:00:00 / 00:00:00" MinWidth="190"
                               TextAlignment="Left" VerticalAlignment="Center" Margin="2,0,8,0" />
                    <Slider Name="SeekSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" />
                </DockPanel>
                <WrapPanel Name="PlaybackButtons" Margin="0,8,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinWidth" Value="32" />
                            <Setter Property="Padding" Value="7,5" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Name="StopButton" Content="■" ToolTip="停止（先頭に戻る）" AutomationProperties.Name="停止" Click="Stop_Click" />
                    <Button Name="PlayPauseButton" Content="▶" ToolTip="再生" AutomationProperties.Name="再生" Click="PlayPause_Click" />
                    <Border Width="12" />
                    <Button Content="−5秒" ToolTip="5秒戻る" Click="BackFive_Click" />
                    <Button Content="−1秒" ToolTip="1秒戻る" Click="BackOne_Click" />
                    <Button Name="FrameBackButton" Content="|◀" ToolTip="1コマ戻る" AutomationProperties.Name="1コマ戻る" Click="FrameBack_Click" />
                    <Button Name="FrameForwardButton" Content="▶|" ToolTip="1コマ進む" AutomationProperties.Name="1コマ進む" Click="FrameStep_Click" />
                    <Button Content="+1秒" ToolTip="1秒進む" Click="ForwardOne_Click" />
                    <Button Content="+5秒" ToolTip="5秒進む" Click="ForwardFive_Click" />
                    <Border Width="12" />
                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Slider Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.7"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    <CheckBox Name="MuteCheck" Content="ミュート" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="MuteCheck_Changed" Unchecked="MuteCheck_Changed" />
                </WrapPanel>
                <TextBlock Name="StatusText" FontSize="{StaticResource UiFontSmall}" Text="動画を追加してください。" Foreground="{StaticResource UiMutedBrush}" Margin="4,8,0,0" />
            </StackPanel>
        </Border>
                <Thumb Name="QualityGraphResizeBar" Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       Cursor="SizeNS" ToolTip="品質グラフの高さを変更" DragDelta="QualityGraphResize_DragDelta"
                       AutomationProperties.Name="品質グラフの高さを変更" Background="#405066" />
                <ContentControl Name="QualityGraphHost" Grid.Row="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            </Grid>
        </Grid>


    </Grid>
</Window>
