<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 大: 画面見出し、中: 操作・本文、小: 補足・目盛り。色は用途で選ぶ。 -->
    <FontFamily x:Key="UiFontFamily">Yu Gothic UI</FontFamily>
    <sys:Double x:Key="UiFontLarge">20</sys:Double>
    <sys:Double x:Key="UiFontMedium">13</sys:Double>
    <sys:Double x:Key="UiFontSmall">11</sys:Double>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#141922" />
    <SolidColorBrush x:Key="PanelBrush" Color="#202837" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F5FA" />
    <SolidColorBrush x:Key="UiEmphasisBrush" Color="#91C9FF" />
    <SolidColorBrush x:Key="UiWarningBrush" Color="#F6D37A" />
    <SolidColorBrush x:Key="UiMutedBrush" Color="#BFCBDB" />
    <SolidColorBrush x:Key="UiOnLightBrush" Color="#17202D" />
    <SolidColorBrush x:Key="UiControlBackgroundBrush" Color="#F1F5FA" />
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
    </Style>
    <Style x:Key="UiTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource UiFontLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="UiSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="UiSmallTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource UiFontSmall}" />
        <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource UiOnLightBrush}" />
        <Setter Property="Background" Value="{StaticResource UiControlBackgroundBrush}" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinWidth" Value="76" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource UiOnLightBrush}" />
        <Setter Property="Background" Value="{StaticResource UiControlBackgroundBrush}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource UiOnLightBrush}" />
        <Setter Property="Background" Value="{StaticResource UiControlBackgroundBrush}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
        <Setter Property="Foreground" Value="{StaticResource UiOnLightBrush}" />
        <Setter Property="Background" Value="{StaticResource UiControlBackgroundBrush}" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PanelBrush}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource UiOnLightBrush}" />
        <Setter Property="Background" Value="{StaticResource UiControlBackgroundBrush}" />
        <Setter Property="Padding" Value="5,6" />
    </Style>
</ResourceDictionary>
