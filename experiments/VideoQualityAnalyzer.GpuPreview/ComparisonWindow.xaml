<Window x:Class="VideoQualityAnalyzer.GpuPreview.ComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フレーム比較" Width="1500" Height="700" Background="#141B26" Foreground="White"
        Closed="Window_Closed">
    <DockPanel Margin="12">
        <TextBlock Name="ResultText" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="左" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Name="LeftSelect" Width="360" DisplayMemberPath="Name" />
            <TextBlock Text="右" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox Name="RightSelect" Width="360" DisplayMemberPath="Name" />
            <TextBlock Text="元フレーム番号" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Name="FrameNumberBox" Width="80" VerticalContentAlignment="Center" />
            <Button Name="PlayPauseButton" Content="再生" Margin="8,0,0,0" Padding="12,4" Click="PlayPause_Click" />
            <Button Content="停止" Margin="6,0,0,0" Padding="12,4" Click="Stop_Click" />
            <TextBlock Text="差分強調" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox Name="GainSelect" Width="68" SelectionChanged="GainSelect_SelectionChanged">
                <ComboBoxItem Content="4倍" Tag="4" />
                <ComboBoxItem Content="16倍" Tag="16" />
                <ComboBoxItem Content="64倍" Tag="64" />
            </ComboBox>
            <TextBlock Text="表示" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox Name="ViewSelect" Width="130" SelectionChanged="ViewSelect_SelectionChanged">
                <ComboBoxItem Content="左右＋差分" />
                <ComboBoxItem Content="境界比較（ワイプ）" />
            </ComboBox>
          </StackPanel>
          <Button Content="指定番号へ移動して再生" HorizontalAlignment="Left" Margin="0,6,0,0"
                  Padding="9,4" Click="SeekPlay_Click" />
        </StackPanel>
        <Grid>
            <Grid Name="ThreeViewGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="左フレーム" DockPanel.Dock="Top" Margin="0,0,0,5" />
                    <Border Background="Black"><Image Name="LeftImage" Stretch="Uniform" /></Border>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="右フレーム" DockPanel.Dock="Top" Margin="0,0,0,5" />
                    <Border Background="Black"><Image Name="RightImage" Stretch="Uniform" /></Border>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock Text="差分ヒートマップ" DockPanel.Dock="Top" Margin="0,0,0,5" />
                    <Border Background="Black"><Image Name="HeatmapImage" Stretch="Uniform" /></Border>
                </DockPanel>
            </Grid>
            <DockPanel Name="WipeViewGrid" Visibility="Collapsed">
                <Grid Name="WipeViewport" Background="Black" ClipToBounds="True">
                    <Image Name="WipeLeftImage" Stretch="Uniform" />
                    <Grid Name="WipeRightLayer">
                        <Image Name="WipeRightImage" Stretch="Uniform" />
                    </Grid>
                    <Border Background="#AA141B26" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="8" Padding="8,4" IsHitTestVisible="False">
                        <TextBlock Name="WipePositionText" />
                    </Border>
                    <Grid Name="WipeBoundary" Width="24" Background="Transparent"
                          HorizontalAlignment="Left" Cursor="SizeWE">
                        <Border Width="3" Background="#FFE651" HorizontalAlignment="Center"
                                IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </DockPanel>
            <Image Name="BenchmarkMarker" Width="48" Height="48" Visibility="Collapsed"
                   HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Grid>
    </DockPanel>
</Window>
