<Window x:Class="VideoQualityAnalyzer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}"
        Title="設定" Width="1000" Height="597" MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Grid.IsSharedSizeScope="True">
            <TextBlock Text="表示スタイル" Style="{StaticResource UiSectionStyle}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingNames" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="画面の配色" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <ComboBox x:Name="DisplayStyleBox" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                          SelectedValuePath="Tag" AutomationProperties.Name="表示スタイル"
                          BorderBrush="{StaticResource UiControlBorderBrush}">
                    <ComboBoxItem Content="標準（None）" Tag="None" />
                    <ComboBoxItem Content="Windows に合わせる（System）" Tag="System" />
                    <ComboBoxItem Content="ライト（Light）" Tag="Light" />
                    <ComboBoxItem Content="ダーク（Dark）" Tag="Dark" />
                </ComboBox>
            </Grid>
            <TextBlock Text="標準は従来のWPF表示です。Windows に合わせる場合は、起動時のWindowsアプリ用配色を使用します。変更は次回起動時に反映されます。"
                       Style="{StaticResource UiSmallTextStyle}" TextWrapping="Wrap" Margin="0,0,0,18" />
            <TextBlock Text="FFmpeg" Style="{StaticResource UiSectionStyle}" Margin="0,0,0,4" />
            <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SettingNames" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="FFmpegフォルダーパス" VerticalAlignment="Center" Margin="0,0,8,0" HorizontalAlignment="Right" />
                <TextBox x:Name="FolderPathBox" Grid.Column="1" VerticalAlignment="Center" VerticalContentAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" d:Text="C:\Tools\ffmpeg\bin" BorderBrush="{StaticResource UiControlBorderBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="フォルダーを選択" Click="SelectFolder_Click" Margin="0,0,8,0" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Content="再検出" Click="Detect_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Margin="8,4,0,0">
                    <Button x:Name="DownloadButton" Content="ffmpegを取得" Click="Download_Click" Margin="0,0,8,0" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button x:Name="CancelDownloadButton" Content="ダウンロードを中断" Click="CancelDownload_Click" Visibility="Collapsed" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <TextBlock x:Name="DownloadStatus" TextWrapping="Wrap" MaxWidth="300" />
                </StackPanel>
                <TextBlock x:Name="DetectionStatus" Grid.Column="1" Grid.Row="1"
                           TextWrapping="Wrap" Margin="0,8,0,0" d:Text="toolsフォルダ内のffmpegを使用" />
                <TextBlock Grid.Row="1" Text="使用するffmpeg" VerticalAlignment="Top" Margin="0,8,8,0" HorizontalAlignment="Right" />
                <TextBlock x:Name="VersionText" Grid.Column="1" Grid.Row="2"
                           TextWrapping="Wrap" Margin="0,4,0,0" d:Text="ffmpeg version 9.0.2" />
                <TextBlock Grid.Row="2" Text="バージョン" VerticalAlignment="Top" Margin="0,4,8,0" HorizontalAlignment="Right" />
                <Border Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource UiMutedBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,8">
                    <TextBlock TextWrapping="Wrap"><Run Text="必要なファイル: ffmpeg.exe , ffprobe.exe"/><LineBreak/><Run Language="ja-jp" Text="見つからない場合は"/><Run Text="tool"/><Run Language="ja-jp" Text="フォルダ"/><Run Text="配下、次にPATHから自動検出します。"/><LineBreak/><Run Text="「ffmpegを取得」はGyanの配布URLから最新安定版をダウンロードし、tools\ffmpeg\以下へ保存します。"/><LineBreak/><Run Text="FFmpeg公式サイト: "/><Hyperlink NavigateUri="https://ffmpeg.org/" RequestNavigate="Website_RequestNavigate" Foreground="{StaticResource UiEmphasisBrush}">https://ffmpeg.org/</Hyperlink><LineBreak/><Run Text="GyanのFFmpeg配布サイト: "/><Hyperlink NavigateUri="https://www.gyan.dev/ffmpeg/builds/" RequestNavigate="Website_RequestNavigate" Foreground="{StaticResource UiEmphasisBrush}">https://www.gyan.dev/ffmpeg/builds/</Hyperlink><LineBreak/><Run Text="保存した設定は次回起動時から反映されます。"/></TextBlock>
                </Border>
                <TextBlock x:Name="ErrorText" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="{StaticResource UiWarningBrush}" />
            </Grid>
        </StackPanel>
        </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="18,0,18,18" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button x:Name="SaveButton" Content="保存" IsDefault="True" Click="Save_Click" VerticalAlignment="Bottom" Margin="0,0,8,0" BorderBrush="{StaticResource UiControlBorderBrush}" />
                <Button Content="キャンセル" IsCancel="True" BorderBrush="{StaticResource UiControlBorderBrush}" />
            </StackPanel>
    </Grid>
</Window>
