<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 大: 画面見出し、中: 操作・本文、小: 補足・目盛り。色は用途で選ぶ。 -->
    <FontFamily x:Key="UiFontFamily">Yu Gothic UI</FontFamily>
    <sys:Double x:Key="UiFontLarge">20</sys:Double>
    <sys:Double x:Key="UiFontMedium">14</sys:Double>
    <sys:Double x:Key="UiFontSmall">12</sys:Double>
    <sys:Double x:Key="UiControlMinHeight">32</sys:Double>
    <sys:Double x:Key="UiSpace4">4</sys:Double>
    <sys:Double x:Key="UiSpace8">8</sys:Double>
    <sys:Double x:Key="UiSpace12">12</sys:Double>
    <sys:Double x:Key="UiSpace16">16</sys:Double>
    <Thickness x:Key="UiButtonPadding">12,4</Thickness>
    <Thickness x:Key="UiInputPadding">8,4</Thickness>
    <!-- Fluent Darkで明色になる一覧の選択行だけを補正する。 -->
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource UiSelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource UiSelectedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="UiTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource UiFontLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="UiSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="UiSmallTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource UiFontSmall}" />
        <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}" />
    </Style>
    <Style x:Key="UiPreviewTabHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource UiVideoTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource UiEmphasisBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontMedium}" />
    </Style>
    <!-- 縦横共通のサイズ変更バー。見た目とマウスの操作範囲を分ける。 -->
    <ControlTemplate x:Key="ResizeBarTemplate" TargetType="Thumb">
        <Grid Background="Transparent">
            <Border x:Name="Line" Height="1" Background="{StaticResource UiSeparatorBrush}" VerticalAlignment="Center" />
            <Border x:Name="Grip" Width="36" Height="3" CornerRadius="1.5" Background="{StaticResource UiMutedBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Vertical">
                <Setter TargetName="Line" Property="Height" Value="Auto" />
                <Setter TargetName="Line" Property="Width" Value="1" />
                <Setter TargetName="Line" Property="VerticalAlignment" Value="Stretch" />
                <Setter TargetName="Line" Property="HorizontalAlignment" Value="Center" />
                <Setter TargetName="Grip" Property="Width" Value="3" />
                <Setter TargetName="Grip" Property="Height" Value="36" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{StaticResource UiEmphasisBrush}" />
                <Setter TargetName="Grip" Property="Background" Value="{StaticResource UiEmphasisBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{StaticResource UiEmphasisBrush}" />
                <Setter TargetName="Grip" Property="Background" Value="{StaticResource UiEmphasisBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{StaticResource UiEmphasisBrush}" />
                <Setter TargetName="Grip" Property="Background" Value="{StaticResource UiEmphasisBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
