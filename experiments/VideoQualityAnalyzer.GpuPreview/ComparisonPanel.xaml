<UserControl x:Class="VideoQualityAnalyzer.GpuPreview.ComparisonPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type UserControl}}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel x:Name="ComparisonLayoutRoot" Margin="12">
        <StackPanel Name="CommonControls" DockPanel.Dock="Top" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="左" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Name="LeftSelect" Width="360" DisplayMemberPath="Name" />
            <TextBlock Text="右" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox Name="RightSelect" Width="360" DisplayMemberPath="Name" />
            <TextBlock Text="元フレーム番号" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Name="FrameNumberBox" Width="80" VerticalContentAlignment="Center" />
            <Button Name="PlayPauseButton" Content="再生" Margin="8,0,0,0" Padding="12,4" Click="PlayPause_Click" />
            <Button Content="停止" Margin="6,0,0,0" Padding="12,4" Click="Stop_Click" />
          </StackPanel>
          <Button Content="指定番号へ移動して再生" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="9,4" Click="SeekPlay_Click" />
        </StackPanel>
        <StackPanel Name="ZoomControls" DockPanel.Dock="Top" Margin="0,0,0,8" />
        <Grid>
            <TabControl Name="ViewSelect" SelectionChanged="ViewSelect_SelectionChanged"
                        Background="{StaticResource UiPreviewChromeBrush}"
                        BorderBrush="{StaticResource UiPanelBorderBrush}" BorderThickness="1">
                <TabItem Name="TwoScreenTab" BorderBrush="{StaticResource UiControlBorderBrush}" BorderThickness="1">
                    <TabItem.Header><TextBlock Text="2画面" Style="{StaticResource UiPreviewTabHeaderStyle}" /></TabItem.Header>
                    <ContentControl Name="TwoScreenContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </TabItem>
                <TabItem Name="WipeTab" BorderBrush="{StaticResource UiControlBorderBrush}" BorderThickness="1">
                    <TabItem.Header><TextBlock Text="ワイプ" Style="{StaticResource UiPreviewTabHeaderStyle}" /></TabItem.Header>
            <DockPanel Name="WipeViewGrid" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <ComboBox Name="WipeLeftPreviewSelect" DisplayMemberPath="Name" ItemsSource="{Binding Items, ElementName=LeftSelect}" SelectedItem="{Binding SelectedItem, ElementName=LeftSelect, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Text, ElementName=LeftDetails}" Style="{StaticResource UiSmallTextStyle}" />
                        <TextBlock Text="{Binding Text, ElementName=LeftFrameStatus}" Style="{StaticResource UiSmallTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ComboBox Name="WipeRightPreviewSelect" DisplayMemberPath="Name" ItemsSource="{Binding Items, ElementName=RightSelect}" SelectedItem="{Binding SelectedItem, ElementName=RightSelect, Mode=TwoWay}" />
                        <TextBlock Text="{Binding Text, ElementName=RightDetails}" Style="{StaticResource UiSmallTextStyle}" />
                        <TextBlock Text="{Binding Text, ElementName=RightFrameStatus}" Style="{StaticResource UiSmallTextStyle}" />
                    </StackPanel>
                </Grid>
                <Grid Name="WipeViewport" Background="Black" ClipToBounds="True">
                    <Image Name="WipeLeftImage" Stretch="Uniform" />
                    <Grid Name="WipeRightLayer">
                        <Image Name="WipeRightImage" Stretch="Uniform" />
                    </Grid>
                    <Border Background="{StaticResource UiVideoOverlayBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="8" Padding="8,4" IsHitTestVisible="False">
                        <TextBlock Name="WipePositionText" Foreground="{StaticResource UiVideoTextBrush}" />
                    </Border>
                    <Grid Name="WipeBoundary" Width="24" Background="Transparent"
                          HorizontalAlignment="Left" Cursor="SizeWE">
                        <Border Width="3" Background="#FFE651" HorizontalAlignment="Center"
                                IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </DockPanel>
                </TabItem>

                <TabItem Name="HeatmapTab" BorderBrush="{StaticResource UiControlBorderBrush}" BorderThickness="1">
                    <TabItem.Header><TextBlock Text="差分ヒートマップ" Style="{StaticResource UiPreviewTabHeaderStyle}" /></TabItem.Header>
                    <DockPanel>
                        <WrapPanel Name="HeatmapOptions" TextElement.Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,8,0,8">
            <TextBlock Name="BlurLabel" Text="ヒートマップのぼかし" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox Name="BlurSelect" Width="105" SelectionChanged="BlurSelect_SelectionChanged">
                <ComboBoxItem Content="ぼかしなし" Tag="0" />
                <ComboBoxItem Content="弱" Tag="1" />
                <ComboBoxItem Content="中" Tag="2" />
                <ComboBoxItem Content="強" Tag="4" />
            </ComboBox>
                        </WrapPanel>
                        <ContentControl Name="HeatmapContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Grid.IsSharedSizeScope="True" Name="ThreeViewGrid" TextElement.Foreground="{StaticResource TextBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Name="HeatmapColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="PreviewHeader" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Name="LeftFrameLabel" Text="左フレーム" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" Visibility="Collapsed" />
                        <ComboBox Name="LeftPreviewSelect" DisplayMemberPath="Name" ItemsSource="{Binding Items, ElementName=LeftSelect}" SelectedItem="{Binding SelectedItem, ElementName=LeftSelect, Mode=TwoWay}" Margin="0,0,0,5" />
                        <TextBlock Name="LeftDetails" FontSize="{StaticResource UiFontSmall}" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,5" />
                        <TextBlock Name="LeftFrameStatus" Style="{StaticResource UiSmallTextStyle}" Margin="0,0,0,5" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="Black"><Image Name="LeftImage" Stretch="Uniform" /></Border>
                </Grid>
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="PreviewHeader" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Name="RightFrameLabel" Text="右フレーム" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" Visibility="Collapsed" />
                        <ComboBox Name="RightPreviewSelect" DisplayMemberPath="Name" ItemsSource="{Binding Items, ElementName=RightSelect}" SelectedItem="{Binding SelectedItem, ElementName=RightSelect, Mode=TwoWay}" Margin="0,0,0,5" />
                        <TextBlock Name="RightDetails" FontSize="{StaticResource UiFontSmall}" Foreground="{StaticResource UiMutedBrush}" Margin="0,0,0,5" />
                        <TextBlock Name="RightFrameStatus" Style="{StaticResource UiSmallTextStyle}" Margin="0,0,0,5" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="Black"><Image Name="RightImage" Stretch="Uniform" /></Border>
                </Grid>
                <Grid Name="HeatmapPanel" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="PreviewHeader" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="差分ヒートマップ" VerticalAlignment="Center" />
            <ComboBox Name="GainSelect" ToolTip="差分強調" Margin="8,0,0,0" Width="112" SelectionChanged="GainSelect_SelectionChanged">
                <ComboBoxItem Content="4倍" Tag="4" />
                <ComboBoxItem Content="16倍" Tag="16" />
                <ComboBoxItem Content="64倍" Tag="64" />
            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="Black"><Image Name="HeatmapImage" Stretch="Uniform" /></Border>
                </Grid>
            </Grid>
                        </ContentControl>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <Image Name="BenchmarkMarker" Width="48" Height="48" Visibility="Collapsed"
                   HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Grid>
    </DockPanel>
</UserControl>
