<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishDir;PublishUrl">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VideoQualityAnalyzer</AssemblyName>
    <!-- 公開バージョンはリリース時に手動で更新する。 -->
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ComparisonPanel.Telemetry.cs" Link="ComparisonPanel.Telemetry.cs" />
    <Page Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ZoomControlBar.xaml" Link="ZoomControlBar.xaml" />
    <Compile Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ZoomControlBar.xaml.cs" Link="ZoomControlBar.xaml.cs" />
    <Page Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ComparisonPanel.xaml" Link="ComparisonPanel.xaml" />
    <Compile Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ComparisonPanel.Zoom.cs" Link="ComparisonPanel.Zoom.cs" />
    <Compile Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ComparisonPanel.xaml.cs" Link="ComparisonPanel.xaml.cs" />
    <Compile Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\ComparisonWindow.cs" Link="ComparisonWindow.cs" />
    <Compile Include="..\..\experiments\VideoQualityAnalyzer.GpuPreview\WipeBoundaryController.cs" Link="WipeBoundaryController.cs" />
    <ProjectReference Include="..\VideoQualityAnalyzer.Core\VideoQualityAnalyzer.Core.csproj" />
    <ProjectReference Include="..\VideoQualityAnalyzer.Media\VideoQualityAnalyzer.Media.csproj" />
    <ProjectReference Include="..\VideoQualityAnalyzer.Diagnostics\VideoQualityAnalyzer.Diagnostics.csproj" />
  </ItemGroup>
  <Target Name="SetGitBuildNumber" BeforeTargets="GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-parse --is-shallow-repository" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitShallowRepository" />
    </Exec>
    <Error Condition="'$(GitShallowRepository)' != 'false'" Text="ビルド番号にはGitの全履歴が必要です。浅いクローンではなく、全履歴を取得してください。" />
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBuildNumber" />
    </Exec>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+$'))" Text="公開バージョンは 1.0.0 のように3つの数値で指定してください。" />
    <Error Condition="$(GitBuildNumber) &gt; 65534" Text="コミット数がファイルバージョンの上限を超えました。採番方式を見直してください。" />
    <PropertyGroup>
      <FileVersion>$(Version).$(GitBuildNumber)</FileVersion>
    </PropertyGroup>
  </Target>
  <!-- Visual Studioが渡す発行先も、取得済みのビルド番号で確定する。 -->
  <Target Name="SetReleasePublishDirectory" BeforeTargets="PrepareForBuild;PrepareForPublish" DependsOnTargets="SetGitBuildNumber"
          Condition="'$(DesignTimeBuild)' != 'true' And ('$(PublishProfileName)' == 'ReleaseProfile' Or '$(PublishProfile)' == 'ReleaseProfile' Or ('$(WebPublishProfileFile)' != '' And $([System.IO.Path]::GetFileNameWithoutExtension('$(WebPublishProfileFile)')) == 'ReleaseProfile'))">
    <PropertyGroup>
      <PublishDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\publish\$(AssemblyName)-v$(Version)-build$(GitBuildNumber)-$(RuntimeIdentifier)\</PublishDir>
      <PublishUrl>$(PublishDir)</PublishUrl>
    </PropertyGroup>
  </Target>
</Project>
