<Window x:Class="VideoQualityAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="動画品質アナライザー"
        Width="1800" Height="860" MinWidth="980" MinHeight="620"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="動画品質アナライザー" FontSize="22" FontWeight="SemiBold" Margin="2,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1060" MinWidth="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="動画一覧" FontSize="16" FontWeight="SemiBold" Margin="3,2,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="追加" Click="Add_Click" />
                            <Button Content="元動画に設定" Click="SetReference_Click" MinWidth="100" />
                            <Button Content="削除" Click="Remove_Click" />
                            <Button Content="品質評価" Click="Evaluate_Click" />
                            <Button Content="グループ設定" Click="SetGroup_Click" />
                        </WrapPanel>
                        <TextBlock Text="複数選択できます。ファイルのドラッグ＆ドロップにも対応。" TextWrapping="Wrap" Foreground="#BFCBDB" Margin="3,0,3,8" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Name="InfoText" Text="動画を追加してください。" TextWrapping="Wrap" Foreground="#D6E2F2" Margin="3,9,3,2" />
                    <DataGrid Name="VideoList" SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="VideoList_SelectionChanged" Sorting="VideoList_Sorting"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="True" RowHeaderWidth="0"
                              Background="#17202D" Foreground="White" RowBackground="#17202D" AlternatingRowBackground="#202837"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="#17202D" />
                                <Setter Property="Padding" Value="5,6" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ファイル名" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="230" />
                            <DataGridTextColumn Header="グループ" Binding="{Binding Group}" SortMemberPath="Group" Width="100" />
                            <DataGridTextColumn Header="解像度" Binding="{Binding Resolution}" SortMemberPath="Resolution" Width="SizeToCells" MinWidth="80" MaxWidth="110" />
                            <DataGridTextColumn Binding="{Binding FrameRateText}" SortMemberPath="FrameRate" Width="SizeToCells" MinWidth="65" MaxWidth="115">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="fps" ToolTip="可変表示は、公称fpsと平均fpsの差による推定です。全フレームの時刻による判定ではありません。" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="コーデック" Binding="{Binding Descriptor.Codec}" SortMemberPath="Codec" Width="SizeToCells" MinWidth="70" MaxWidth="100" />
                            <DataGridTextColumn Header="kbps" Binding="{Binding AverageBitrateKbps, StringFormat=N0}" SortMemberPath="Bitrate" Width="SizeToCells" MinWidth="65" MaxWidth="100" />
                            <DataGridTextColumn Header="VMAF" Binding="{Binding VmafAverage, StringFormat=F4}" SortMemberPath="Vmaf" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn Header="SSIM" Binding="{Binding SsimAverage, StringFormat=F4}" SortMemberPath="Ssim" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn Header="PSNR" Binding="{Binding PsnrAverage, StringFormat=F4}" SortMemberPath="Psnr" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#405066" />
            <Grid Grid.Column="2" Name="PreviewLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Name="PreviewRow" Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Name="QualityGraphRow" Height="260" MinHeight="200" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Name="LegacyPreviewGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <MediaElement Name="LeftMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Opacity="0"
                                          ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="LeftMedia_Opened" MediaFailed="LeftMedia_Failed" MediaEnded="Media_Ended" />
                            <Image Name="LeftAv1Image" Stretch="Uniform" Visibility="Collapsed" />
                            <Border VerticalAlignment="Top" Background="#CC17202D" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Name="LeftName" Text="左: 未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Name="LeftStatus" Text="待機中" Foreground="#C6D6EA" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <MediaElement Name="RightMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Opacity="0"
                                          ScrubbingEnabled="True" Stretch="Uniform" IsMuted="True"
                                          MediaOpened="RightMedia_Opened" MediaFailed="RightMedia_Failed" MediaEnded="Media_Ended" />
                            <Image Name="RightAv1Image" Stretch="Uniform" Visibility="Collapsed" />
                            <Border VerticalAlignment="Top" Background="#CC17202D" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Name="RightName" Text="右: 未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Name="RightStatus" Text="待機中" Foreground="#C6D6EA" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <ContentControl Grid.Row="0" Name="ComparisonHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <TextBlock Grid.Row="1" Name="MeasurementText" Text="再生位置からの換算fps: 左 — / 右 —　｜　実提示fps: 未測定"
                           Foreground="#F6D37A" Margin="4,10,4,4" TextWrapping="Wrap" />
        <Border Name="PlaybackControls" Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Name="TimeText" DockPanel.Dock="Right" Text="00:00:00 / 00:00:00" MinWidth="190"
                               TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0" />
                    <Slider Name="SeekSlider" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" />
                </DockPanel>
                <TextBlock Name="FrameText" Text="フレーム位置: 左 — / 右 —" Foreground="#D6E2F2" Margin="4,5,0,0" TextWrapping="Wrap" />
                <WrapPanel Name="PlaybackButtons" Margin="0,8,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinWidth" Value="32" />
                            <Setter Property="Padding" Value="7,5" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Name="StopButton" Content="■" ToolTip="停止（先頭に戻る）" AutomationProperties.Name="停止" Click="Stop_Click" />
                    <Button Name="PlayPauseButton" Content="▶" ToolTip="再生" AutomationProperties.Name="再生" Click="PlayPause_Click" />
                    <Border Width="12" />
                    <Button Content="−5秒" ToolTip="5秒戻る" Click="BackFive_Click" />
                    <Button Content="−1秒" ToolTip="1秒戻る" Click="BackOne_Click" />
                    <Button Name="FrameBackButton" Content="|◀" ToolTip="1コマ戻る" AutomationProperties.Name="1コマ戻る" Click="FrameBack_Click" />
                    <Button Name="FrameForwardButton" Content="▶|" ToolTip="1コマ進む" AutomationProperties.Name="1コマ進む" Click="FrameStep_Click" />
                    <Button Content="+1秒" ToolTip="1秒進む" Click="ForwardOne_Click" />
                    <Button Content="+5秒" ToolTip="5秒進む" Click="ForwardFive_Click" />
                    <Border Width="12" />
                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Slider Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.7"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    <CheckBox Name="MuteCheck" Content="ミュート" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="MuteCheck_Changed" Unchecked="MuteCheck_Changed" />
                </WrapPanel>
                <TextBlock Name="StatusText" Text="動画を追加してください。" Foreground="#BFCBDB" Margin="4,8,0,0" />
            </StackPanel>
        </Border>
                <Thumb Name="QualityGraphResizeBar" Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       Cursor="SizeNS" ToolTip="品質グラフの高さを変更" DragDelta="QualityGraphResize_DragDelta"
                       AutomationProperties.Name="品質グラフの高さを変更" Background="#405066" />
                <ContentControl Name="QualityGraphHost" Grid.Row="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            </Grid>
        </Grid>


    </Grid>
</Window>
