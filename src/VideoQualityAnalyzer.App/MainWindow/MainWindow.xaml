<Window x:Class="VideoQualityAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:VideoQualityAnalyzer.App"
        xmlns:preview="clr-namespace:VideoQualityAnalyzer.GpuPreview"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="VideoQualityAnalyzer"
        Width="1800" Height="900" MinWidth="980" MinHeight="620"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CenteredFileCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="RightFileCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="CenteredFileHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RightFileHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CenteredFileHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </Window.Resources>
    <DockPanel Background="{StaticResource BackgroundBrush}">
        <Menu DockPanel.Dock="Top"
              FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiFontMedium}">
            <MenuItem Header="ファイル">
                <MenuItem Header="動画を読み込む" Click="Add_Click"
                          IsEnabled="{Binding IsEnabled, ElementName=AddVideoButton}" />
                <MenuItem Header="動画をすべて削除" Click="RemoveAll_Click"
                          IsEnabled="{Binding IsEnabled, ElementName=RemoveVideoButton}" />
                <Separator />
                <MenuItem Header="フレームグラフの元データをCSV出力" Click="ExportFrameCsv_Click" />
                <MenuItem Header="ファイルグラフの元データをCSV出力" Click="ExportFileCsv_Click" />
                <MenuItem x:Name="SaveGraphImageMenuItem" Header="グラフを画像にして保存" Click="SaveGraphImage_Click" />
                <Separator />
                <MenuItem Header="終了" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="オプション">
                <MenuItem Header="設定" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="ヘルプ">
                <MenuItem Header="バージョン情報" Click="About_Click" />
            </MenuItem>
        </Menu>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="SidebarColumn" Width="700" MinWidth="300" />
                <ColumnDefinition Name="SidebarSplitterColumn" Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Name="SidebarPanel" Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource UiPanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,8">
                            <Button Name="AddVideoButton" Content="動画ファイルを追加" Click="Add_Click" Margin="0,0,8,0" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                            <Button Name="RemoveVideoButton" Content="動画を削除" Click="Remove_Click" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                        </WrapPanel>
                    <TextBlock Text="基準動画" Style="{StaticResource UiSectionStyle}" Margin="0,0,0,6" />
                    <DataGrid Name="ReferenceList" Height="82" Margin="0,0,0,8" RowHeight="32" ColumnHeaderHeight="32" SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="ReferenceList_SelectionChanged" CanUserSortColumns="False"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="True" RowHeaderWidth="0"
                              Background="{StaticResource UiListBackgroundBrush}"
                              HorizontalGridLinesBrush="{StaticResource UiGridLineBrush}"
                              VerticalGridLinesBrush="{StaticResource UiGridLineBrush}"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ファイル名" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="230" />
                            <DataGridTextColumn Header="グループ" Binding="{Binding Source=--}" SortMemberPath="Group" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource CenteredFileCellStyle}" HeaderStyle="{StaticResource CenteredFileHeaderStyle}" Header="コーデック" Binding="{Binding Descriptor.Codec}" SortMemberPath="Codec" Width="SizeToCells" MinWidth="70" MaxWidth="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="kbps" Binding="{Binding AverageBitrateKbps, StringFormat=N0, TargetNullValue=--}" SortMemberPath="Bitrate" Width="SizeToCells" MinWidth="65" MaxWidth="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="VMAF" Binding="{Binding Source=--}" SortMemberPath="Vmaf" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="SSIM" Binding="{Binding Source=--}" SortMemberPath="Ssim" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="PSNR" Binding="{Binding Source=--}" SortMemberPath="Psnr" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource CenteredFileCellStyle}" HeaderStyle="{StaticResource CenteredFileHeaderStyle}" Header="解像度" Binding="{Binding Resolution}" SortMemberPath="Resolution" Width="SizeToCells" MinWidth="80" MaxWidth="110" />
                            <DataGridTextColumn ElementStyle="{StaticResource CenteredFileCellStyle}" HeaderStyle="{StaticResource CenteredFileHeaderStyle}" Binding="{Binding FrameRateText}" SortMemberPath="FrameRate" Width="SizeToCells" MinWidth="65" MaxWidth="115">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="fps" ToolTip="可変表示は、公称fpsと平均fpsの差による推定です。全フレームの時刻による判定ではありません。" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        <DockPanel Margin="0,0,0,8">
                            <Button Name="SetReferenceButton" DockPanel.Dock="Left" HorizontalAlignment="Left" Content="▲基準動画に設定" Click="SetReference_Click" MinWidth="100" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="グループ設定" Click="SetGroup_Click" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                                <Button Content="グループ解除" Click="ClearGroup_Click" ToolTip="選択した比較動画のグループ設定を解除します。" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Name="EvaluationControls" DockPanel.Dock="Bottom" Margin="3,10,3,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="EvaluationClearButton" Content="評価クリア" Click="ClearEvaluation_Click" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" Margin="0,0,8,0" BorderBrush="{StaticResource UiControlBorderBrush}" />
                            <Button Name="EvaluationRangeButton" Content="評価を開始" Click="Evaluate_Click" MinWidth="220" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiButtonPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="評価対象動画" Style="{StaticResource UiSectionStyle}" Margin="0,0,0,6" />
                    <DataGrid Name="VideoList" RowHeight="32" ColumnHeaderHeight="32" SelectionMode="Extended" SelectionUnit="FullRow"
                              PreviewMouseLeftButtonDown="VideoList_PreviewMouseLeftButtonDown" SelectionChanged="VideoList_SelectionChanged" Sorting="VideoList_Sorting"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="True" RowHeaderWidth="0"
                              Background="{StaticResource UiListBackgroundBrush}"
                              HorizontalGridLinesBrush="{StaticResource UiGridLineBrush}"
                              VerticalGridLinesBrush="{StaticResource UiGridLineBrush}"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ファイル名" Binding="{Binding DisplayName}" SortMemberPath="Name" Width="230" />
                            <DataGridTextColumn Header="グループ" Binding="{Binding Group}" SortMemberPath="Group" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource CenteredFileCellStyle}" HeaderStyle="{StaticResource CenteredFileHeaderStyle}" Header="コーデック" Binding="{Binding Descriptor.Codec}" SortMemberPath="Codec" Width="SizeToCells" MinWidth="70" MaxWidth="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="kbps" Binding="{Binding AverageBitrateKbps, StringFormat=N0}" SortMemberPath="Bitrate" Width="SizeToCells" MinWidth="65" MaxWidth="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="VMAF" Binding="{Binding VmafAverage, StringFormat=F4}" SortMemberPath="Vmaf" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="SSIM" Binding="{Binding SsimAverage, StringFormat=F4}" SortMemberPath="Ssim" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource RightFileCellStyle}" HeaderStyle="{StaticResource RightFileHeaderStyle}" Header="PSNR" Binding="{Binding PsnrAverage, StringFormat=F4}" SortMemberPath="Psnr" Width="SizeToCells" MinWidth="65" MaxWidth="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource CenteredFileCellStyle}" HeaderStyle="{StaticResource CenteredFileHeaderStyle}" Header="解像度" Binding="{Binding Resolution}" SortMemberPath="Resolution" Width="SizeToCells" MinWidth="80" MaxWidth="110" />
                            <DataGridTextColumn ElementStyle="{StaticResource CenteredFileCellStyle}" HeaderStyle="{StaticResource CenteredFileHeaderStyle}" Binding="{Binding FrameRateText}" SortMemberPath="FrameRate" Width="SizeToCells" MinWidth="65" MaxWidth="115">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="fps" ToolTip="可変表示は、公称fpsと平均fpsの差による推定です。全フレームの時刻による判定ではありません。" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Name="SidebarSplitter" Template="{StaticResource ResizeBarTemplate}" Tag="Vertical" Cursor="SizeWE" ToolTip="動画一覧の幅を変更" AutomationProperties.Name="動画一覧の幅を変更" Grid.Column="1" Margin="0,36,0,0" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource UiSeparatorBrush}" />
            <Button Name="SidebarToggleButton" Grid.Column="1" Content="◀" ToolTip="一覧を最小化" AutomationProperties.Name="一覧を最小化"
                    Click="SidebarToggle_Click" Width="18" Height="30" MinWidth="0" Padding="0" Margin="1,0,1,0" VerticalAlignment="Top"
                    Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" />
            <Grid Grid.Column="2" Name="PreviewLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Name="PreviewRow" Height="1.2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Name="QualityGraphRow" Height="*" MinHeight="200" />
                </Grid.RowDefinitions>
                <TabControl Name="InitialPreviewTabs" Grid.Row="0" SelectedIndex="0"
                            Background="{StaticResource UiPreviewChromeBrush}" Foreground="{StaticResource UiVideoTextBrush}"
                            BorderBrush="{StaticResource UiPanelBorderBrush}" BorderThickness="1">
                    <TabItem MinHeight="{StaticResource UiControlMinHeight}" BorderBrush="{StaticResource UiControlBorderBrush}" BorderThickness="1">
                        <TabItem.Header><TextBlock Text="2画面" Style="{StaticResource UiPreviewTabHeaderStyle}" /></TabItem.Header>
                <Grid Name="LegacyPreviewGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <MediaElement Name="LeftMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Opacity="0"
                                          ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="LeftMedia_Opened" MediaFailed="LeftMedia_Failed" MediaEnded="Media_Ended" />
                            <Image Name="LeftAv1Image" Stretch="Uniform" Visibility="Collapsed" />
                            <Border VerticalAlignment="Top" Background="{StaticResource UiVideoOverlayBrush}" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Name="LeftName" Text="左: 未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Foreground="{StaticResource UiVideoTextBrush}" />
                                    <ComboBox Name="PreviewLeftSelect" DisplayMemberPath="Descriptor.Name" SelectionChanged="PreviewVideo_SelectionChanged" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiInputPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                                    <TextBlock Name="LeftDetails" FontSize="{StaticResource UiFontSmall}" Foreground="{StaticResource UiVideoMutedBrush}" Margin="6,0,0,0" />
                                    <TextBlock Name="LeftFrameStatus" Style="{StaticResource UiSmallTextStyle}" Foreground="{StaticResource UiVideoMutedBrush}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <MediaElement Name="RightMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Opacity="0"
                                          ScrubbingEnabled="True" Stretch="Uniform" IsMuted="True"
                                          MediaOpened="RightMedia_Opened" MediaFailed="RightMedia_Failed" MediaEnded="Media_Ended" />
                            <Image Name="RightAv1Image" Stretch="Uniform" Visibility="Collapsed" />
                            <Border VerticalAlignment="Top" Background="{StaticResource UiVideoOverlayBrush}" Padding="10,7">
                                <StackPanel>
                                    <TextBlock Name="RightName" Text="右: 未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Foreground="{StaticResource UiVideoTextBrush}" />
                                    <ComboBox Name="PreviewRightSelect" DisplayMemberPath="Descriptor.Name" SelectionChanged="PreviewVideo_SelectionChanged" MinHeight="{StaticResource UiControlMinHeight}" Padding="{StaticResource UiInputPadding}" BorderBrush="{StaticResource UiControlBorderBrush}" />
                                    <TextBlock Name="RightDetails" FontSize="{StaticResource UiFontSmall}" Foreground="{StaticResource UiVideoMutedBrush}" Margin="6,0,0,0" />
                                    <TextBlock Name="RightFrameStatus" Style="{StaticResource UiSmallTextStyle}" Foreground="{StaticResource UiVideoMutedBrush}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                    </TabItem>
                    <TabItem MinHeight="{StaticResource UiControlMinHeight}" BorderBrush="{StaticResource UiControlBorderBrush}" BorderThickness="1">
                        <TabItem.Header><TextBlock Text="ワイプ" Style="{StaticResource UiPreviewTabHeaderStyle}" /></TabItem.Header>
                        <TextBlock Text="比較する動画を2本選択してください。" Margin="12" />
                    </TabItem>
                    <TabItem MinHeight="{StaticResource UiControlMinHeight}" BorderBrush="{StaticResource UiControlBorderBrush}" BorderThickness="1">
                        <TabItem.Header><TextBlock Text="差分ヒートマップ" Style="{StaticResource UiPreviewTabHeaderStyle}" /></TabItem.Header>
                        <TextBlock Text="比較する動画を2本選択してください。" Margin="12" />
                    </TabItem>
                </TabControl>
                <ContentControl Grid.Row="0" Name="ComparisonHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Border Name="PlaybackControls" Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource UiPanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Name="TimeText" DockPanel.Dock="Left" Text="00:00:00 / 00:00:00" MinWidth="190"
                               TextAlignment="Left" VerticalAlignment="Center" Margin="2,0,8,0" />
                    <Slider Name="SeekSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp" />
                </DockPanel>
                <local:PriorityWrapPanel x:Name="PlaybackButtons" Margin="0,8,0,0">
                    <local:PriorityWrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinWidth" Value="32" />
                            <Setter Property="MinHeight" Value="{StaticResource UiControlMinHeight}" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </local:PriorityWrapPanel.Resources>
                    <StackPanel Orientation="Horizontal" local:PriorityWrapPanel.Priority="99">
                    <Button Name="StopButton" Content="■" ToolTip="停止（先頭に戻る）" AutomationProperties.Name="停止" Click="Stop_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Name="PlayPauseButton" Content="▶" ToolTip="再生" AutomationProperties.Name="再生" Click="PlayPause_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" local:PriorityWrapPanel.Priority="2">
                    <Button Content="−5秒" ToolTip="5秒戻る" Click="BackFive_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Content="−1秒" ToolTip="1秒戻る" Click="BackOne_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Name="FrameBackButton" Content="|◀" ToolTip="1コマ戻る" AutomationProperties.Name="1コマ戻る" Click="FrameBack_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Name="FrameForwardButton" Content="▶|" ToolTip="1コマ進む" AutomationProperties.Name="1コマ進む" Click="FrameStep_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Content="+1秒" ToolTip="1秒進む" Click="ForwardOne_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    <Button Content="+5秒" ToolTip="5秒進む" Click="ForwardFive_Click" BorderBrush="{StaticResource UiControlBorderBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" local:PriorityWrapPanel.Priority="1">
                    <TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Slider Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.7"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                    <CheckBox Name="MuteCheck" Content="ミュート" VerticalAlignment="Center" Margin="10,0,0,0"
                              Checked="MuteCheck_Changed" Unchecked="MuteCheck_Changed" />

                    </StackPanel>
                    <CheckBox Name="EvaluatedOnlyCheck" Content="評価した部分のみ再生" IsEnabled="False" VerticalAlignment="Center"
                              Margin="12,0,4,0" Checked="EvaluatedOnlyCheck_Changed" Unchecked="EvaluatedOnlyCheck_Changed" local:PriorityWrapPanel.Priority="3"
                              ToolTip="部分評価を完了し、評価済みの比較動画をプレビューに選択してください。" />
                    <preview:ZoomControlBar x:Name="PreviewZoomControls" ShowButtons="False" Margin="16,0,0,0" local:PriorityWrapPanel.Priority="3" />
                    <preview:ZoomControlBar x:Name="PreviewZoomButtons" ShowSlider="False" local:PriorityWrapPanel.Priority="0" />
                </local:PriorityWrapPanel>
            </StackPanel>
        </Border>
                <Button Name="PreviewToggleButton" Grid.Row="3" HorizontalAlignment="Right" Margin="0,0,34,0" Width="30" Height="18" MinWidth="0" Padding="0" Content="▲" ToolTip="プレビューを最小化" Click="PreviewToggle_Click" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" />
                <Thumb Margin="0,0,68,0" Name="QualityGraphResizeBar" Template="{StaticResource ResizeBarTemplate}" Focusable="True" KeyDown="QualityGraphResize_KeyDown" Grid.Row="3" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                       Cursor="SizeNS" ToolTip="品質グラフの高さを変更" DragDelta="QualityGraphResize_DragDelta"
                       AutomationProperties.Name="品質グラフの高さを変更" Background="{StaticResource UiSeparatorBrush}" />
                <Button Name="GraphToggleButton" Grid.Row="3" HorizontalAlignment="Right" Width="30" Height="18" MinWidth="0" Padding="0" Content="▼" ToolTip="グラフを最小化" Click="GraphToggle_Click" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" />
                <ContentControl Name="QualityGraphHost" Grid.Row="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            </Grid>
        </Grid>


        <StatusBar x:Name="WindowStatusBar" Grid.Row="2" Margin="0,8,0,0"
                   Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                   BorderBrush="{StaticResource UiPanelBorderBrush}" BorderThickness="1"
                   FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource UiFontSmall}"
                   AutomationProperties.Name="ステータスバー">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WindowStatusText" Text="待機中" Style="{StaticResource UiSmallTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeasurementText" Grid.Column="1" Style="{StaticResource UiSmallTextStyle}"
                               Text="CPU 計測中 / メモリ 計測中 / GPU 不明"
                               TextAlignment="Right" VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="性能情報" />
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
    </DockPanel>
</Window>
